# Agent image
AGENT_IMAGE=ghcr.io/ph1lippov/drakkar-agent
AGENT_TAG=latest

# Agent runtime
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
DRAKKAR_AGENT_AUTH_SCHEME=hmac-sha256
DRAKKAR_AGENT_HMAC_SECRET=local-dev-secret-123
DRAKKAR_AGENT_TIMESTAMP_SKEW_SEC=60

# Node identity
NODE_ID=local-mac
NODE_REGION=local
NODE_MAX_PEERS=200
NODE_PUBLIC_HOST=127.0.0.1

# Xray <-> Agent
XrayOptions__LocalApiHost=xray
XrayOptions__ApiPort=10086
XrayOptions__PublicHost=127.0.0.1
XrayOptions__InboundTag=vless-reality-in
XrayOptions__VlessFlow=xtls-rprx-vision
XrayOptions__VlessEncryption=none

# Xray image
XRAY_CORE_IMAGE=ghcr.io/xtls/xray-core:latest

# Reality (ставь те же, что в твоем рабочем config.local.json/config.json)
XRAY_INBOUND_TAG=vless-reality-in
XRAY_REALITY_DEST=www.cloudflare.com:443
XRAY_REALITY_SNI=www.cloudflare.com
XRAY_REALITY_PRIVATE_KEY=cCXjyD_SrjWPmHOpcl3h5jxLEqPVACIlydllnQpCAFs
XRAY_REALITY_PUBLIC_KEY=nXv0eaRqPOFdA1ep_SOz_beWbnVEiMu6T3rKyzjyhC0
XRAY_REALITY_SHORT_ID=57a4c8d6b0f1d667
XRAY_CLIENT_UUID=dbac4d1e-7242-47c9-aee0-720e137f4acc

# WG off for local
WG_ENABLE=false
WG_CORE_ENDPOINT=127.0.0.1:51820
WG_CORE_PUBLIC_KEY=replace_me
WG_CORE_IP=10.10.0.1
WG_AGENT_PORT=51820
WG_IP=10.10.10.2
WG_AGENT_PRIVATE_KEY=replace_me
WG_AGENT_PUBLIC_KEY=replace_me