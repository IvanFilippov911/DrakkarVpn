# =========================
# Agent image
# =========================
AGENT_IMAGE=ghcr.io/ph1lippov/drakkar-agent
AGENT_TAG=latest

# =========================
# Agent runtime
# =========================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

DRAKKAR_AGENT_AUTH_SCHEME=hmac-sha256
DRAKKAR_AGENT_HMAC_SECRET=replace_me
DRAKKAR_AGENT_TIMESTAMP_SKEW_SEC=60

# =========================
# Node identity
# =========================
NODE_ID=sw-01
NODE_REGION=sweden
NODE_MAX_PEERS=200
NODE_PUBLIC_HOST=1.2.3.4

# =========================
# Xray <-> Agent
# =========================
XrayOptions__LocalApiHost=xray
XrayOptions__ApiPort=10086
XrayOptions__PublicHost=1.2.3.4
XrayOptions__InboundTag=vless-reality-in

# =========================
# Xray container image (compose + generate-node-secrets.sh docker run x25519)
# =========================
XRAY_CORE_IMAGE=ghcr.io/xtls/xray-core:latest

# =========================
# Xray reality config
# =========================
XRAY_INBOUND_TAG=vless-reality-in
XRAY_REALITY_DEST=www.cloudflare.com:443
XRAY_REALITY_SNI=www.cloudflare.com
XRAY_REALITY_PRIVATE_KEY=replace_me
XRAY_REALITY_PUBLIC_KEY=replace_me
XRAY_REALITY_SHORT_ID=replace_me
XRAY_CLIENT_UUID=replace_me

# =========================
# WireGuard control-plane
# =========================
# When WG_ENABLE=true, deploy-node.sh sets AGENT_HOST_BIND to WG_IP and opens WG_AGENT_PORT/udp in UFW.
# Optional: set AGENT_HOST_BIND yourself when running docker compose without deploy-node (default 127.0.0.1).
WG_ENABLE=false
WG_CORE_ENDPOINT=1.2.3.4:51820
WG_CORE_PUBLIC_KEY=replace_me
WG_CORE_IP=10.10.0.1
WG_AGENT_PORT=51820
WG_IP=10.10.10.2

# Generated on node, usually not in example for manual editing.
# Added here only to document required runtime variables for template rendering.
WG_AGENT_PRIVATE_KEY=replace_me
WG_AGENT_PUBLIC_KEY=replace_me