# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Postgres connection
POSTGRES_HOST=drakkar-postgres
POSTGRES_PORT=5432
POSTGRES_DB=drakkar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=drakkar-redis
REDIS_PORT=6379

# Admin bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@drakkar-network.com
ADMIN_BOOTSTRAP_PASSWORD=change_me

# Admin JWT
ADMIN_JWT_SIGNING_KEY=replace_with_base64_32_byte_key
ADMIN_JWT_ISSUER=drakkar-vpn
ADMIN_JWT_AUDIENCE=drakkar-vpn-admin
ADMIN_JWT_ACCESS_TOKEN_TTL_MINUTES=15

# Domains
WEBAPP_BASE_URL=https://app.drakkar-network.com
VITE_API_BASE=https://api.drakkar-network.com
# Internal container-network URL used by the bot service in docker-compose.
USER_API_URL=http://drakkar-user-api:8080

# TLS certificates directory mounted into nginx
LETSENCRYPT_DIR=/etc/letsencrypt