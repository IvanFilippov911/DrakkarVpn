# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# User JWT (user-api)
USER_JWT_SIGNING_KEY=replace_with_base64_32_byte_key
USER_JWT_ISSUER=drakkar-vpn
USER_JWT_AUDIENCE=drakkar-vpn-clients
USER_JWT_DEFAULT_TTL_MINUTES=43200

# Postgres connection
POSTGRES_HOST=drakkar-postgres
POSTGRES_PORT=5432
POSTGRES_DB=drakkar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=drakkar-redis
REDIS_PORT=6379

# Admin bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@drakkar-network.com
ADMIN_BOOTSTRAP_PASSWORD=change_me

# Admin JWT
ADMIN_JWT_SIGNING_KEY=hT2cQY8w3p0xez0lE7h+8R5v3P3mWqKp+0xgP1n4mXQ=
ADMIN_JWT_ISSUER=drakkar-vpn
ADMIN_JWT_AUDIENCE=drakkar-vpn-admin
ADMIN_JWT_ACCESS_TOKEN_TTL_MINUTES=15

# User JWT (user-api)
USER_JWT_SIGNING_KEY=replace_with_base64_32_byte_key
USER_JWT_ISSUER=drakkar-vpn
USER_JWT_AUDIENCE=drakkar-vpn-clients
USER_JWT_DEFAULT_TTL_MINUTES=43200

# VlessLinkOptions
VlessLinkOptions__TagPrefix=Drakkar
VpnLinkOptions__PeerConfigPath=/api/v1/user/access
VpnLinkOptions__PublicBaseUrl=https://app.drakkarnetwork.com

# Domains
WEBAPP_BASE_URL=https://app.drakkarnetwork.com
VITE_API_BASE=/api
# Happ — ссылки на установку клиента (User UI)
VITE_HAPP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.happproxy
VITE_HAPP_IOS_URL=https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973
VITE_HAPP_MACOS_URL=https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973
# v2RayTun — вторая кнопка на экране «Настраиваем подключение»
VITE_V2RAYTUN_IOS_URL=https://apps.apple.com/us/app/v2raytun/id6476628951?l=ru
VITE_V2RAYTUN_MACOS_URL=https://apps.apple.com/us/app/v2raytun/id6476628951?l=ru
VITE_V2RAYTUN_ANDROID_URL=https://play.google.com/store/apps/details?id=com.v2raytun.android
# Internal container-network URL used by the bot service in docker-compose.
USER_API_INTERNAL_URL=http://drakkar-user-api:8080

# TLS certificates directory mounted into nginx
LETSENCRYPT_DIR=/etc/letsencrypt