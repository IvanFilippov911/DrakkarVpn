# Скопируй в .env.local и при необходимости измени URL.
VITE_API_BASE_URL=http://localhost:5102

# Опционально: переопределение ссылок на Happ (см. deploy/app/.env.example)
# VITE_HAPP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.happproxy
# VITE_HAPP_IOS_URL=https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973
# VITE_HAPP_MACOS_URL=https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973

# Локальная разработка без Telegram WebApp (только в vite dev):
# VITE_TELEGRAM_DEV_BYPASS=true
# Должен совпадать с Auth:DevTelegramId в User.Api appsettings (по умолчанию 7).
# VITE_DEV_TELEGRAM_ID=7
