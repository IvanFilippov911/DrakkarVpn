{"@t":"2025-11-14T21:35:55.6080200Z","@m":"Failed executing DbCommand (\"5\"ms) [Parameters=[\"@__serverId_4='?' (DbType = Guid), @__serverId_0='?' (DbType = Guid), @__nowUtc_1='?' (DbType = DateTime), @__p_3='?' (DbType = Int32), @__p_2='?' (DbType = Int32)\"], CommandType='Text', CommandTimeout='30']\"\n\"\"SELECT s1.id, s1.telegram_id, s1.created_at, s1.status, (\n    SELECT count(*)::int\n    FROM peers AS p0\n    INNER JOIN devices AS d0 ON p0.device_id = d0.device_id\n    INNER JOIN subscriptions AS s3 ON d0.subscription_id = s3.id\n    WHERE p0.server_id = @__serverId_4 AND p0.is_online AND s3.user_id = s1.id), (\n    SELECT count(*)::int\n    FROM (\n        SELECT DISTINCT d1.device_id\n        FROM devices AS d1\n        INNER JOIN subscriptions AS s4 ON d1.subscription_id = s4.id\n        WHERE s4.user_id = s1.id\n    ) AS s5), (\n    SELECT max(p1.last_data_at)\n    FROM peers AS p1\n    INNER JOIN devices AS d2 ON p1.device_id = d2.device_id\n    INNER JOIN subscriptions AS s6 ON d2.subscription_id = s6.id\n    WHERE p1.server_id = @__serverId_4 AND s6.user_id = s1.id AND p1.last_data_at IS NOT NULL)\nFROM (\n    SELECT DISTINCT a.id, a.ban_reason, a.banned_at_utc, a.created_at, a.is_internal, a.status, a.telegram_id\n    FROM peers AS p\n    INNER JOIN devices AS d ON p.device_id = d.device_id\n    INNER JOIN subscriptions AS s ON d.subscription_id = s.id\n    INNER JOIN app_users AS a ON s.user_id = a.id\n    WHERE p.server_id = @__serverId_0 AND s.status = 1 AND a.status = 1\n) AS s1\nLEFT JOIN (\n    SELECT s0.user_id AS \\\"UserId\\\", max(s0.end_at) AS \\\"EndAt\\\"\n    FROM subscriptions AS s0\n    GROUP BY s0.user_id\n) AS s2 ON s1.id = s2.\\\"UserId\\\"\nWHERE s2.\\\"EndAt\\\" IS NOT NULL AND s2.\\\"EndAt\\\" > @__nowUtc_1\nORDER BY s2.\\\"EndAt\\\", s1.id\nLIMIT @__p_3 OFFSET @__p_2\"","@i":"627a98df","@l":"Error","@tr":"dc53e6760a325376f9099ad4c7394a2e","@sp":"98e9d2ecb2088159","elapsed":"5","parameters":"@__serverId_4='?' (DbType = Guid), @